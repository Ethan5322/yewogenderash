// Yewogen Derash — data model.
//
// SHARED SUPABASE PROJECT: this database is shared with the user's other
// apps. EVERY table/enum here maps to a yd_-prefixed Postgres name via
// @@map (yd_users, yd_role, ...). Never create unprefixed objects, and
// never touch tables that don't start with yd_ — they belong to other
// projects. Storage buckets follow the same rule: yd-kyc, yd-media.
//
// Core invariants encoded here:
//   * One campaign = one querycode (unique) = one ledger (donations relation).
//   * Donations belong to exactly one campaign (required FK).
//   * Payouts are per-campaign, admin-approved, and reference the approving admin.
//   * Money is Decimal(12,2) — never floats.
//   * Every webhook event is stored (idempotency + audit).

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: connection URLs live in prisma.config.ts (CLI) and the
// driver adapter in lib/db.ts (runtime) — never here.
datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────

enum Role {
  DONOR
  OWNER
  ADMIN

  @@map("yd_role")
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  RESUBMIT

  @@map("yd_verification_status")
}

enum BiometricStatus {
  NOT_CAPTURED
  PENDING
  VERIFIED
  REJECTED
  RESUBMIT

  @@map("yd_biometric_status")
}

enum CampaignStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  SUSPENDED
  COMPLETED
  ARCHIVED
  REJECTED

  @@map("yd_campaign_status")
}

enum CampaignCategory {
  MEDICAL
  EDUCATION
  COMMUNITY
  BUSINESS
  EMERGENCY
  OTHER

  @@map("yd_campaign_category")
}

enum DonationStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
  DISPUTED

  @@map("yd_donation_status")
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
  CANCELLED

  @@map("yd_payout_status")
}

enum DocumentType {
  NATIONAL_ID
  PASSPORT
  SELFIE
  PROOF_OF_ADDRESS
  MEDICAL_LETTER
  EDUCATION_LETTER
  COMMUNITY_LETTER
  BUSINESS_REGISTRATION
  OTHER_SUPPORTING

  @@map("yd_document_type")
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
  RESUBMIT

  @@map("yd_document_status")
}

enum NotificationChannel {
  WHATSAPP
  EMAIL
  SMS

  @@map("yd_notification_channel")
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED

  @@map("yd_notification_status")
}

enum OtpPurpose {
  EMAIL_VERIFY
  PHONE_VERIFY
  PASSWORD_RESET
  LOGIN_2FA

  @@map("yd_otp_purpose")
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("yd_blog_status")
}

// ── Identity ─────────────────────────────────────────────────────

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  emailVerifiedAt    DateTime?
  phone              String?            @unique
  phoneVerifiedAt    DateTime?
  passwordHash       String
  role               Role               @default(DONOR)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  isBanned           Boolean            @default(false)
  // Delegated administration. A super admin ("main admin") implicitly holds
  // every permission and can manage other admins; sub-admins (role ADMIN,
  // isSuperAdmin false) hold only the capabilities toggled on in
  // adminPermissions, e.g. { "kyc": true, "payouts": false }.
  isSuperAdmin       Boolean            @default(false)
  adminPermissions   Json               @default("{}")
  /// Staff identifier for admins/sub-admins, e.g. YWD-ADM-7KQ2. Issued when an
  /// admin account is created; null for non-admin users.
  adminCode          String?            @unique
  /// Staff biometric + ID-card portrait (admins/sub-admins). idPhotoUrl is the
  /// public portrait shown on the staff ID; faceDescriptor is the enrolled
  /// biometric template; biometricEnrolledAt marks when it was captured.
  idPhotoUrl         String?
  faceDescriptor     String?
  biometricEnrolledAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  ownerProfile CampaignOwner?
  donations    Donation[]
  otpCodes     OtpCode[]
  auditLogs    AuditLog[]     @relation("AuditActor")
  blogPosts    BlogPost[]
  staffMessagesSent     StaffMessage[] @relation("StaffMessageSender")
  staffMessagesReceived StaffMessage[] @relation("StaffMessageRecipient")

  @@map("yd_users")
}

model OtpCode {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   OtpPurpose
  codeHash  String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime   @default(now())

  @@index([userId, purpose])
  @@map("yd_otp_codes")
}

// ── Campaign owners (KYC) ────────────────────────────────────────

model CampaignOwner {
  id                 String          @id @default(cuid())
  userId             String          @unique
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  idNumber           String?
  biometricStatus    BiometricStatus @default(NOT_CAPTURED)
  /// 128-D face descriptor from the live biometric capture (the enrolment
  /// template). Compared against the ID photo at registration and against the
  /// live face at login. Stored as a JSON number array.
  faceDescriptor     Json?
  /// 128-D descriptor detected in the uploaded ID-card photo.
  idPhotoDescriptor  Json?
  /// Raw match score. Meaning depends on faceEngine: face-api = Euclidean
  /// distance (lower better), insightface = cosine similarity (higher better).
  faceMatchScore     Float?
  /// Engine-agnostic verdict: did the live face match the ID photo?
  faceMatched        Boolean?
  /// Which engine produced the verdict: "insightface" or "face-api".
  faceEngine         String?
  /// True when the live capture passed the active liveness challenge (head
  /// turn + blink) — a still photo held to the camera cannot satisfy it.
  livenessPassed     Boolean         @default(false)
  /// Public verification code shown on the author profile (e.g. YWD-A1B2C3)
  authorCode         String?         @unique
  /// Platform trust seal — set only by admin approval, never user-editable
  mulesooVerified    Boolean         @default(false)
  verifiedAt         DateTime?
  /// Anti-fraud: an admin has flagged this owner as suspicious (brief §13).
  flagged            Boolean         @default(false)
  flagReason         String?
  /// Payout account details (bank/telebirr), JSON kept admin-readable only
  payoutAccount      Json?
  /// Public ID-card portrait (gallery upload, auto-cropped square) in yd-media.
  /// Distinct from the private KYC selfie — this is the photo shown ON the
  /// corporate Fundraiser ID card.
  idPhotoUrl         String?
  /// Owner preference: WhatsApp alert on each successful donation
  whatsappAlerts     Boolean         @default(true)
  whatsappPhone      String?
  callmebotApiKey    String?
  termsAcceptedAt    DateTime?
  feesAcceptedAt     DateTime?
  biometricConsentAt DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  campaigns      Campaign[]
  documents      VerificationDocument[]
  payouts        Payout[]
  notifications  Notification[]
  payoutAccounts PayoutAccount[]
  messages       Message[]

  @@map("yd_campaign_owners")
}

model VerificationDocument {
  id           String         @id @default(cuid())
  ownerId      String
  owner        CampaignOwner  @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  documentType DocumentType
  /// Path in the private Supabase Storage bucket — never a public URL
  fileUrl      String
  status       DocumentStatus @default(PENDING)
  adminNote    String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([ownerId, status])
  @@map("yd_verification_documents")
}

// ── Campaigns ────────────────────────────────────────────────────

model Campaign {
  id            String           @id @default(cuid())
  ownerId       String
  owner         CampaignOwner    @relation(fields: [ownerId], references: [id])
  title         String
  slug          String           @unique
  description   String
  story         String?
  category      CampaignCategory
  targetAmount  Decimal          @db.Decimal(12, 2)
  /// Denormalised sum of SUCCESS donations — updated only inside the same
  /// transaction that marks a donation SUCCESS/REFUNDED.
  currentAmount Decimal          @default(0) @db.Decimal(12, 2)
  currency      String           @default("ETB")
  status        CampaignStatus   @default(DRAFT)
  /// One campaign, one querycode. QR encodes /q/[queryCode].
  queryCode     String           @unique
  /// Admin can disable a querycode without touching the campaign — the /q link
  /// and QR stop resolving while it is false.
  queryCodeActive Boolean        @default(true)
  qrCodeUrl     String?
  heroImageUrl  String?
  location      String?
  endDate       DateTime?
  isFeatured    Boolean          @default(false)
  /// Anti-fraud: an admin has flagged this campaign as suspicious (brief §13).
  flagged       Boolean          @default(false)
  flagReason    String?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  donations     Donation[]
  payouts       Payout[]
  updates       CampaignUpdate[]
  notifications Notification[]
  feeLedgers    FeeLedger[]
  documents     CampaignDocument[]

  @@index([status, category])
  @@index([ownerId])
  @@map("yd_campaigns")
}

model CampaignUpdate {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  title      String
  body       String
  createdAt  DateTime @default(now())

  @@index([campaignId])
  @@map("yd_campaign_updates")
}

/// Per-campaign proof document (brief §6.1/§6.2): the category-matched evidence
/// a fundraiser must attach to EACH campaign at creation — a hospital letter for
/// a medical campaign, a school letter for education, etc. Stored privately in
/// yd-kyc; only admins view it (signed URLs), and they check it before approval.
model CampaignDocument {
  id           String         @id @default(cuid())
  campaignId   String
  campaign     Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  documentType DocumentType
  /// Path in the private Supabase Storage bucket — never a public URL.
  fileUrl      String
  status       DocumentStatus @default(PENDING)
  adminNote    String?
  createdAt    DateTime       @default(now())

  @@index([campaignId])
  @@map("yd_campaign_documents")
}

// ── Money ────────────────────────────────────────────────────────

model Donation {
  id                   String         @id @default(cuid())
  campaignId           String
  campaign             Campaign       @relation(fields: [campaignId], references: [id])
  /// Optional — anonymous donations are allowed
  donorId              String?
  donor                User?          @relation(fields: [donorId], references: [id])
  donorName            String?
  /// Gross amount the donor paid (what Chapa charged).
  amount               Decimal        @db.Decimal(12, 2)
  /// Platform fee taken via Chapa split at transaction time (3% of gross).
  platformFee          Decimal        @default(0) @db.Decimal(12, 2)
  /// Net credited to the campaign = amount − platformFee.
  netAmount            Decimal        @default(0) @db.Decimal(12, 2)
  /// Fee rate applied, kept for audit even if the platform rate changes later.
  feeRate              Decimal        @default(0.03) @db.Decimal(5, 4)
  currency             String         @default("ETB")
  paymentMethod        String?
  /// Our transaction reference sent to Chapa (tx_ref) — unique for idempotency
  txRef                String         @unique
  gatewayTransactionId String?
  status               DonationStatus @default(PENDING)
  webhookPayload       Json?
  paidAt               DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  feeLedger FeeLedger?

  @@index([campaignId, status])
  @@index([donorId])
  @@map("yd_donations")
}

/// NOTE: a partial unique index guarantees ONE live payout per campaign —
/// unique on campaignId WHERE status IN ('REQUESTED','APPROVED','PAID'). Prisma
/// cannot express a WHERE clause on an index, so that constraint exists only in
/// supabase/migrations/0020_yd_one_live_payout_per_campaign.sql. It is recorded
/// here because an index the schema does not know about is exactly the kind of
/// drift that hid the missing isSuperAdmin column (migration 0019). Do not
/// "tidy" it away, and do not expect `prisma db push` to recreate it.
model Payout {
  id                String        @id @default(cuid())
  campaignId        String
  campaign          Campaign      @relation(fields: [campaignId], references: [id])
  ownerId           String
  owner             CampaignOwner @relation(fields: [ownerId], references: [id])
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("ETB")
  status            PayoutStatus  @default(REQUESTED)
  payoutReference   String?
  approvedByAdminId String?
  approvedAt        DateTime?
  paidAt            DateTime?
  note              String?
  /// True when the automated approval rules cleared this request (no human
  /// reviewer). See lib/payouts.ts evaluateAutoApproval().
  autoApproved      Boolean       @default(false)
  /// Snapshot of which rule decided this request, for audit.
  reviewReason      String?
  /// Safety & guarantee withholding taken from THIS withdrawal (see
  /// lib/fees.ts WITHHOLDING_FEE_RATE). The campaign owes 7% of its gross once;
  /// whatever is still outstanding is charged here, so instalment withdrawals
  /// are never double-charged. Retained by the platform.
  withholdingFee    Decimal       @default(0) @db.Decimal(12, 2)
  /// What is actually transferred to the fundraiser: amount − withholdingFee.
  /// Stored rather than derived so a historical payout still reads correctly if
  /// the rate ever changes.
  netPaidAmount     Decimal?      @db.Decimal(12, 2)
  /// ── Provider (Chapa) transfer state ────────────────────────────────────
  /// Deliberately separate from `status` above: that is the business state, this
  /// is what the bank did. When they disagree, reconciliation needs both.
  ///
  /// `transferReference` is OURS, generated once and stored BEFORE Chapa is
  /// called. Chapa accepts a merchant `reference` and their verify endpoint looks
  /// up by it, which makes it the idempotency key — a crash mid-flight leaves
  /// evidence instead of ambiguity. A partial unique index enforces one per
  /// payout; Prisma cannot express a WHERE clause on an index, so it lives in
  /// supabase/migrations/0021_yd_add_payout_transfers.sql. Do not "tidy" it away.
  ///
  /// `transferStatus`: null = never attempted, PENDING = attempted and the
  /// outcome is NOT known (never retry these automatically), SUCCESS/FAILED =
  /// confirmed by Chapa, never inferred from a timeout.
  transferReference     String?
  transferStatus        String?
  transferAttemptedAt   DateTime?
  transferFailureReason String?
  chapaTransferId       String?
  /// Raw provider response, verbatim. Chapa's verify response shape is not fully
  /// documented, so this payload is what settles a disputed transfer.
  transferResponse      Json?
  /// The payout account (verified bank / Chapa subaccount) funds are sent to.
  payoutAccountId   String?
  payoutAccountRef  PayoutAccount? @relation(fields: [payoutAccountId], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([campaignId])
  @@index([ownerId, status])
  @@map("yd_payouts")
}

/// Raw gateway webhook events — stored before processing for idempotency,
/// replay protection, and audit. Never delete.
model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String    @default("chapa")
  /// Provider event id or tx_ref — unique so duplicates are ignored
  externalRef String    @unique
  payload     Json
  signatureOk Boolean
  processedAt DateTime?
  outcome     String?
  createdAt   DateTime  @default(now())

  @@map("yd_webhook_events")
}

// ── Notifications ────────────────────────────────────────────────

model Notification {
  id         String              @id @default(cuid())
  ownerId    String?
  owner      CampaignOwner?      @relation(fields: [ownerId], references: [id])
  campaignId String?
  campaign   Campaign?           @relation(fields: [campaignId], references: [id])
  channel    NotificationChannel
  message    String
  status     NotificationStatus  @default(QUEUED)
  error      String?
  sentAt     DateTime?
  createdAt  DateTime            @default(now())

  @@index([ownerId])
  @@index([campaignId])
  @@map("yd_notifications")
}

// ── Governance ───────────────────────────────────────────────────

/// Append-only log of every admin action (and security-relevant user events).
/// Internal staff line: a private one-to-one message between two admins.
///
/// Deliberately NOT the `Message` model. That one hangs off CampaignOwner and is
/// the fundraiser line, gated behind the `messages` capability. This one is
/// between staff, carries no owner, and is open to EVERY admin regardless of
/// their capability map — a sub-admin who only holds `kyc` must still be able to
/// answer the main admin. Keeping them as separate tables is what stops one
/// line's permissions or read state leaking into the other.
model StaffMessage {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("StaffMessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User      @relation("StaffMessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  body        String
  /// Null until the recipient opens the thread. Read state belongs to the
  /// recipient only — the sender's own message is never "unread" to them.
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  /// Unread badge: "messages to me I have not read".
  @@index([recipientId, readAt])
  /// Thread fetch: both directions between one pair, in order.
  @@index([senderId, recipientId, createdAt])
  @@map("yd_staff_messages")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id])
  action     String
  entityType String?
  entityId   String?
  detail     Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@map("yd_audit_logs")
}

/// Admin-managed site content (home copy, FAQ, fees, banners, contact...)
model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedBy String?
  updatedAt DateTime @updatedAt

  @@map("yd_site_content")
}

/// Editable platform policy — a single "singleton" row. Super-admin only.
/// `feeRate` governs the split baked into NEW Chapa subaccounts (each account
/// also records the rate it was created with, so ledgers always reconcile);
/// `autoApproveMaxEtb` is the ceiling for automated payout approval.
model PlatformSettings {
  id                String   @id @default("singleton")
  feeRate           Float    @default(0.03)
  autoApproveMaxEtb Int      @default(5000)
  minPayoutEtb      Int      @default(100)
  /// Above this, a payout is not transferred from the app — an admin moves it by
  /// hand as they do today. A ceiling means a bug in the send path costs the
  /// ceiling, not a campaign's entire balance.
  maxAutoTransferEtb Int     @default(25000)
  updatedById       String?
  updatedAt         DateTime @updatedAt

  @@map("yd_platform_settings")
}

/// Public contact messages and abuse reports, reviewed by admins in the
/// Support inbox. `type` = "CONTACT" | "REPORT"; `status` = "OPEN" | "RESOLVED".
model SupportMessage {
  id        String   @id @default(cuid())
  type      String   @default("CONTACT")
  name      String
  email     String
  /// For reports: the campaign querycode or link being reported.
  code      String?
  reason    String?
  message   String
  status    String   @default("OPEN")
  adminNote String?
  /// Case handoff: which admin owns this case (User.id) and when it was assigned.
  assignedToId String?
  assignedAt   DateTime?
  createdAt DateTime @default(now())

  @@index([type, status, createdAt])
  @@map("yd_support_messages")
}

// ── Money ledger & balances ──────────────────────────────────────

/// One row per SUCCESS donation recording the exact fee split. Append-only
/// financial record — gross = donor paid, fee = platform's 3% cut (taken by
/// Chapa split at transaction time), net = credited to the campaign balance.
/// Never mutate a row; corrections are new compensating rows.
model FeeLedger {
  id                String   @id @default(cuid())
  donationId        String   @unique
  donation          Donation @relation(fields: [donationId], references: [id])
  campaignId        String
  campaign          Campaign @relation(fields: [campaignId], references: [id])
  grossAmount       Decimal  @db.Decimal(12, 2)
  feeAmount         Decimal  @db.Decimal(12, 2)
  netAmount         Decimal  @db.Decimal(12, 2)
  feeRate           Decimal  @db.Decimal(5, 4)
  currency          String   @default("ETB")
  /// Chapa subaccount the net portion was split to (fundraiser's bank).
  chapaSubaccountId String?
  createdAt         DateTime @default(now())

  @@index([campaignId])
  @@map("yd_fee_ledger")
}

// CampaignBalance / yd_campaign_balances was REMOVED in migration 0022.
//
// Its doc comment called it "the authoritative balance surface, kept in sync
// inside the same transaction that settles a donation or pays out". The first
// half was true; the second never was. Donations incremented it and refunds
// decremented it, but no payout ever touched it and totalWithdrawn was never
// written at all, so after a withdrawal it reported the full net as still
// available. Three separate comments elsewhere in this codebase already said
// "computed from the ledger, not the CampaignBalance denorm, so it stays correct
// even if it drifts" — it had been superseded and routed around, but not deleted.
//
// Balances now have ONE source: campaignAvailableBalance() in lib/payouts.ts,
// which computes successful donations minus reserved payouts. Slightly more work
// per read, and it cannot be wrong.
//
// Do not reintroduce a balance table without also handling payout creation,
// rejection, cancellation and transfer failure — forgetting one of those is
// exactly how the last one started lying.

/// A fundraiser's verified payout destination. Promoted from the old
/// CampaignOwner.payoutAccount JSON to a first-class table so each account
/// maps to a Chapa subaccount and carries its own verification state.
model PayoutAccount {
  id                String        @id @default(cuid())
  ownerId           String
  owner             CampaignOwner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  accountName       String
  bankName          String
  /// Chapa bank id (from the /banks endpoint) used to create the subaccount.
  bankCode          String
  accountNumber     String
  /// Chapa subaccount id — the split target for this owner's donations.
  chapaSubaccountId String?
  /// Platform fee rate baked into this subaccount's Chapa split at creation.
  /// Settle uses THIS rate (not the current global) so the ledger always
  /// reconciles with what Chapa actually routed, even after the fee changes.
  feeRate           Float?
  isVerified        Boolean       @default(false)
  verifiedAt        DateTime?
  /// The owner's currently active payout account (only one should be true).
  isDefault         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payouts Payout[]

  @@index([ownerId])
  @@map("yd_payout_accounts")
}

// ── Messaging (fundraiser ↔ admin) ───────────────────────────────

/// A message between a fundraiser and the admin team.
///  - Owner→admin and admin→owner replies both carry `ownerId` (the thread).
///  - An admin NOTICE to every fundraiser is `isBroadcast` with `ownerId` null.
/// `fromAdmin` gives direction; the read flags drive unread badges per side.
model Message {
  id           String         @id @default(cuid())
  ownerId      String?
  owner        CampaignOwner? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// The user who wrote it (admin user or the owner's user). Kept for audit.
  senderUserId String?
  fromAdmin    Boolean        @default(false)
  isBroadcast  Boolean        @default(false)
  subject      String?
  body         String
  readByOwner  Boolean        @default(false)
  readByAdmin  Boolean        @default(false)
  createdAt    DateTime       @default(now())

  @@index([ownerId, createdAt])
  @@index([isBroadcast, createdAt])
  @@map("yd_messages")
}

// ── Blog / content marketing ─────────────────────────────────────

/// Public blog posts (trust content, success stories, guides). Authored by
/// admins; only PUBLISHED posts are visible on the public site.
model BlogPost {
  id            String     @id @default(cuid())
  slug          String     @unique
  title         String
  excerpt       String
  body          String
  coverImageUrl String?
  status        BlogStatus @default(DRAFT)
  authorId      String?
  author        User?      @relation(fields: [authorId], references: [id])
  publishedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([status, publishedAt])
  @@map("yd_blog_posts")
}
